# syntax=docker/dockerfile:1

# --- build the React console -----------------------------------------------
FROM node:20-alpine AS build

WORKDIR /app

COPY web/package*.json ./
RUN npm install

COPY web/ ./
RUN npm run build

# --- serve static assets + reverse proxy to API ----------------------------
FROM nginx:alpine

# The official nginx image runs envsubst on /etc/nginx/templates/*.template at
# startup, so the ${VULNFORGE_API_HOST} placeholder is substituted at runtime.
ENV VULNFORGE_API_HOST=api

COPY docker/nginx.conf /etc/nginx/templates/default.conf.template
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
