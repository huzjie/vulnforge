# Normalize line endings and enforce UTF-8 text handling.

# Python sources: LF only
*.py text eol=lf

# Documentation and config
*.md text
*.txt text
*.rst text

# Config / data formats
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.toml text eol=lf

# Frontend
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.html text eol=lf

# Shell / Docker / CI
*.sh text eol=lf
Dockerfile text eol=lf
.dockerignore text eol=lf
.gitignore text eol=lf
Makefile text eol=lf

# Binary formats (always keep as binary)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
